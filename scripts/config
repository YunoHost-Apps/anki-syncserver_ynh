#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# LOAD SETTINGS
#=================================================
ynh_script_progression --message="Loading installation settings..." --weight=1

# Get old values
old_sync_user_1=$(ynh_app_setting_get --app=$app --key=sync_user_1)
old_sync_password_1=$(ynh_app_setting_get --app=$app --key=sync_password_1)
old_sync_user_2=$(ynh_app_setting_get --app=$app --key=sync_user_2)
old_sync_password_2=$(ynh_app_setting_get --app=$app --key=sync_password_2)
old_sync_user_3=$(ynh_app_setting_get --app=$app --key=sync_user_3)
old_sync_password_3=$(ynh_app_setting_get --app=$app --key=sync_password_3)
old_sync_user_4=$(ynh_app_setting_get --app=$app --key=sync_user_4)
old_sync_password_4=$(ynh_app_setting_get --app=$app --key=sync_password_4)
old_sync_user_5=$(ynh_app_setting_get --app=$app --key=sync_user_5)
old_sync_password_5=$(ynh_app_setting_get --app=$app --key=sync_password_5)
old_max_sync_payload_megs=$(ynh_app_setting_get --app=$app --key=max_sync_payload_megs)

#=================================================
# SHOW_CONFIG FUNCTION FOR 'SHOW' COMMAND
#=================================================

show_config() {    
    ynh_return "YNH_CONFIG_main_sync_users_sync_user_1=$old_sync_user_1"
    ynh_return "YNH_CONFIG_main_sync_users_sync_password_1="
    ynh_return "YNH_CONFIG_main_sync_users_sync_user_2=$old_sync_user_2"
    ynh_return "YNH_CONFIG_main_sync_users_sync_password_2="
    ynh_return "YNH_CONFIG_main_sync_users_sync_user_3=$old_sync_user_3"
    ynh_return "YNH_CONFIG_main_sync_users_sync_password_3="
    ynh_return "YNH_CONFIG_main_sync_users_sync_user_4=$old_sync_user_4"
    ynh_return "YNH_CONFIG_main_sync_users_sync_password_4="
    ynh_return "YNH_CONFIG_main_sync_users_sync_user_5=$old_sync_user_5"
    ynh_return "YNH_CONFIG_main_sync_users_sync_password_5="
    ynh_return "YNH_CONFIG_main_limits_max_sync_payload_megs=$old_max_sync_payload_megs"
}

#=================================================
# MODIFY THE CONFIGURATION
#=================================================

apply_config() {
    # Save new settings
    
    last_n=1

    for i in 1 2 3 4 5; do
        user_var="YNH_CONFIG_main_sync_users_sync_user_${i}";
        password_var="YNH_CONFIG_main_sync_users_sync_password_${i}";
        if [ -n "${!user_var}" ]; then
            ynh_app_setting_set --app=$app --key="sync_user_${last_n}" --value="${!user_var}"
            if [ -n "${!password_var}" ]; then
                hashed_pass=$(password_hash "${!password_var}")
                ynh_app_setting_set --app=$app --key="sync_password_${last_n}" --value="$password_hash"
            else
                copy_from="old_sync_password_${i}"
                ynh_app_setting_set --app=$app --key="sync_password_${last_n}" --value="${!copy_from}"
            fi;

            last_n=$(($last_n+1));
        fi;
    done

    for i in 1 2 3 4 5; do
    if [ $i -ge $last_n ]; then
        ynh_app_setting_set --app=$app --key="sync_user_${i}" --value=""
        ynh_app_setting_set --app=$app --key="sync_password_${i}" --value=""
    fi
    done

    ynh_app_setting_set --app=$app --key=max_sync_payload_megs --value="$max_sync_payload_megs"
    
    # Reconfigure systemd service with new environment variables
    ynh_script_progression --message="Updating systemd configuration..." --weight=1
    configure_systemd_service
    
    # Restart the service
    ynh_script_progression --message="Restarting $app service..." --weight=1
    ynh_systemd_action --service_name=$app --action="restart" --log_path="/var/log/$app/$app.log"
}

#=================================================
# GENERIC FINALIZATION
#=================================================

ynh_app_config_run $1

